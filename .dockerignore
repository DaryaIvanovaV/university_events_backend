# Віртуальне оточення хоста: усередині образу своє, а копіювання чужого
# ламає шляхи до інтерпретатора.
.venv/
venv/

# Секрети. У контейнер змінні приходять через env_file/environment,
# запікати .env у шар образу не можна — він лишиться в історії шарів.
.env
.env.docker

# Локальні бази і бекапи
*.db
*.db.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE і git
.idea/
.vscode/
.git/
.gitignore

# Результати прогонів перевірки промта — мегабайти HTML, в образі не потрібні
reports/

# Документація і разові файли
docs/
global_to_remove.txt
