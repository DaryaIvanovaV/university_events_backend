# Віртуальне оточення
.venv/
venv/

# Секрети: реальний пароль БД і токен бота. У репозиторій не йдуть —
# шаблони лежать у .env.example і .env.docker.example
.env
.env.docker

# Ключ сервісного акаунта Firebase (secrets/fcm.json): дає право слати push усім
# підписникам. Слеш на початку — тільки корінь репозиторію.
/secrets/

# Локальні бази даних
*.db
*.db.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# IDE
.idea/
.vscode/

# Результати прогонів перевірки промта (генеруються, важать мегабайти).
# УВАГА: цінне з reports/ продубльовано в data/labels/ і data/baselines/ —
# саме воно відстежується git і переїжджає на інші машини.
reports/

# Ваги моделей і чекпоїнти навчання: сотні мегабайт, у git не місце.
# Готовий GGUF переносити вручну (флешка/хмара).
# УВАГА: слеш на початку обов'язковий. Без нього патерн матчив і пакет
# app/models/ — схеми Pydantic та ORM ніколи не комітилися і були втрачені.
/models/
/checkpoints/
*.gguf
*.safetensors

# Разовий список пакетів для чистки глобального Python
global_to_remove.txt
/docs/
/CLAUDE.md
