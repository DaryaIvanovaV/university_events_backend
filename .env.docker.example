# Змінні для docker compose. Скопіюйте в .env.docker і заповніть.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Файл використовується двічі: Compose бере звідси підстановки ${...} для
# docker-compose.yml (прапорець --env-file), а контейнери отримують ці самі
# змінні як своє оточення (env_file:). В образ він НЕ потрапляє —
# доданий у .dockerignore.

# === PostgreSQL ===
# Виділена роль застосунку, а не суперкористувач postgres: якщо контейнер
# API скомпрометують, у нього не буде прав на всю СКБД.
POSTGRES_USER=events
POSTGRES_PASSWORD=ЗАМІНІТЬ_МЕНЕ
POSTGRES_DB=events
# Порт Postgres на хості — тільки для docker-compose.dev.yml. 5433, бо
# 5432 зайнятий локально встановленим PostgreSQL.
POSTGRES_HOST_PORT=5433

# DATABASE_URL тут задавати НЕ треба: docker-compose.yml збирає рядок
# підключення зі змінних вище і підставляє хост `db` (ім'я сервісу).

# === Порт API на хості ===
API_PORT=8000

# === Версія Python для збірки образу ===
# 3.13 — безпечний дефолт: під неї точно є готові wheel для grpcio
# (залежність firebase-admin). Подробиці в коментарі в Dockerfile.
PYTHON_VERSION=3.13

# === Ollama ===
# Варіант за замовчуванням: Ollama працює на ХОСТІ (там налаштований GPU).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Переїзд у контейнер — розкоментуйте рядок нижче, закоментуйте верхній
# і підніміть профіль:  docker compose --profile ollama up -d
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434

OLLAMA_MODEL=gemma3:4b
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=0
OLLAMA_TIMEOUT_S=300
OLLAMA_CONNECT_TIMEOUT_S=5
OLLAMA_KEEP_ALIVE=15m
OLLAMA_WARMUP_ON_STARTUP=true
LLM_MAX_RETRIES=2

# === Безпека API ===
# ОБОВ'ЯЗКОВО заповнити: порт 8000 проброшено на хост, і без ключів приймання
# повідомлень та модерація (approve/reject/PATCH) відкриті всім, хто до нього
# дотягнеться. Згенерувати: python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
ADMIN_API_KEY=
# Origins для браузерних клієнтів через кому (вебпанель модерації).
# Мобільному застосунку CORS не потрібен — залиште порожнім, якщо його немає.
CORS_ORIGINS=

# === Черга і воркер ===
WORKER_POLL_INTERVAL_S=2.0
WORKER_BATCH_SIZE=1
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_S=30
WORKER_LEASE_TIMEOUT_S=900
JOB_POLL_INTERVAL_S=1.5
JOB_POLL_TIMEOUT_S=300

# === Часовий пояс ===
# За ним рахується «сьогодні» для фільтра upcoming у фіді. Час процесу в
# контейнері — UTC, і без цього налаштування вночі показувалися б учорашні події.
APP_TIMEZONE=Europe/Kyiv

# === Автоочищення минулих подій ===
# Через скільки діб ПІСЛЯ СТАРТУ події вона отримує статус expired: зникає
# з фіду, а її id їде в `removed` у GET /events/sync, тож мобільний
# застосунок прибирає картку з локального кеша. 0 — вимкнути очищення.
EVENT_EXPIRE_AFTER_DAYS=1
# Через скільки днів після дати події рядок expired видаляється з БД
# остаточно. Пристрій, який не синхронізувався довше, сигналу `removed` уже
# не побачить — тому строк з запасом. 0 — не видаляти ніколи.
EVENT_PURGE_AFTER_DAYS=90
# Як часто воркер робить прохід прибирання (секунди).
CLEANUP_INTERVAL_S=3600

# === Telegram-бот (профіль bot) ===
BOT_TOKEN=
ADMIN_CHAT_IDS=
ALLOWED_CHANNELS=

# === FCM push-сповіщення ===
# Шлях УСЕРЕДИНІ контейнера. docker-compose.yml монтує ./secrets у /run/secrets
# (read-only, тільки в api), тож ключ із Firebase Console (Project settings →
# Service accounts → Generate new private key) кладемо як secrets/fcm.json.
# Без файлу залиште значення порожнім: push тоді лише пишеться в лог.
FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
FCM_DEFAULT_TOPIC=conferences
