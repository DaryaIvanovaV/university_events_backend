# === База даних ===
# dev (за замовчуванням): SQLite-файл — нічого ставити не треба
DATABASE_URL=sqlite:///./events.db
# prod: PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/events
#
# ВАЖЛИВО: схему накочує Alembic, а не create_all.
#   alembic upgrade head                 — на порожній базі
#   alembic stamp 0001 && alembic upgrade head  — якщо таблиця events уже є
# Автостворення таблиць лишилося тільки для SQLite (див. app/main.py).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_S=1800

# === Часовий пояс ===
# За ним рахується «сьогодні» для фільтра upcoming. У Docker час процесу —
# UTC, і без цього налаштування вночі у фіді показувалися б учорашні події.
APP_TIMEZONE=Europe/Kyiv

# === Локальна LLM (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
# Легка модель за замовчуванням (~3-4 ГБ). Ще легші: qwen2.5:3b, gemma3:1b.
# Важчі й точніші (якщо вистачає заліза): gemma3:12b, qwen2.5:14b.
# Вибір під залізо: GPU ≥6 ГБ VRAM або CPU+RAM ≥16 ГБ → 4b; слабкий CPU/≤8 ГБ → 1b.
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEMPERATURE=0.0
# Розмір контекстного вікна. 0 = дефолт Ollama (рекомендовано).
# Менше ~2400 ставити не можна: промпт займає ~2106 токенів, відповідь ще ~200,
# і модель почне мовчки отримувати обрізаний текст. Замір впливу на швидкість:
# python -m scripts.bench_llm
OLLAMA_NUM_CTX=0
# Таймаут генерації, сек. Із запасом на холодний старт (перше завантаження моделі).
OLLAMA_TIMEOUT_S=300
# Таймаут лише на підключення, сек — швидка відмова, якщо сервер не запущено.
OLLAMA_CONNECT_TIMEOUT_S=5
# Скільки тримати модель у пам'яті між запитами (формат Ollama: 15m, 1h, -1).
OLLAMA_KEEP_ALIVE=15m
# Прогрівати модель при старті backend у фоні (true/false).
OLLAMA_WARMUP_ON_STARTUP=true
LLM_MAX_RETRIES=2

# === Telegram Bot API (aiogram) ===
# Токен від @BotFather. Бота треба додати АДМІНОМ цільового каналу —
# тоді він отримує НОВІ дописи (історію Bot API не читає; див. імпорт нижче).
BOT_TOKEN=
# id адміністраторів ЧЕРЕЗ КОМУ, без лапок. Їм бот шле картки модерації.
# Приклад двох:  ADMIN_CHAT_IDS=111111111, 222222222
# Дізнатися свій id: надіслати боту команду /id
# ВАЖЛИВО: кожен адмін має один раз написати боту /start — інакше бот не зможе
# надіслати йому картку (Telegram забороняє боту писати першим).
ADMIN_CHAT_IDS=
# Необов'язковий білий список каналів (@username або -100...id, через
# кому). Порожньо = приймати дописи з усіх каналів, де бот адмін.
ALLOWED_CHANNELS=

# === Черга і воркер ===
# /events/ingest лише ставить повідомлення в чергу (таблиця ingest_jobs) і
# відповідає 202. Видобування виконує окремий процес: python -m app.worker
WORKER_POLL_INTERVAL_S=2.0
WORKER_BATCH_SIZE=1
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_S=30
# Задача, що зависла в processing довше за цей строк, вважається покинутою
# (воркер убитий) і повертається в чергу.
WORKER_LEASE_TIMEOUT_S=900
# Як клієнти (бот, імпортер) чекають результат через GET /jobs/{id}
JOB_POLL_INTERVAL_S=1.5
JOB_POLL_TIMEOUT_S=300

# === Безпека API ===
# Порожньо = перевірка вимкнена (локальна розробка на 127.0.0.1). Щойно
# порт видно ззовні — заповнити, інакше ingest і модерація відкриті всім.
# Згенерувати: python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
ADMIN_API_KEY=
# Origins для браузерних клієнтів через кому. Мобільному застосунку не потрібно.
CORS_ORIGINS=

# === Внутрішній API (куди бот та імпортер шлють повідомлення) ===
# 127.0.0.1, а не localhost (на Windows localhost може йти в IPv6 ::1).
API_BASE_URL=http://127.0.0.1:8000

# === FCM push-сповіщення ===
FCM_CREDENTIALS_PATH=
FCM_DEFAULT_TOPIC=conferences
